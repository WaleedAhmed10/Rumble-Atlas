PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/royal-rumble

# REQUIRED in production: a long random secret used to sign login tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Website address(es) allowed to call this API (comma separated), e.g. your Vercel URL.
# Leave empty in development (localhost:3000 is allowed automatically).
CLIENT_ORIGIN=
